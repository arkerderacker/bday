<script>
(()=>{const gate=document.getElementById('birthday-gate'),site=document.getElementById('site-content'),form=document.getElementById('birthday-form'),input=document.getElementById('birthday-answer'),error=document.getElementById('birthday-error');document.body.style.overflow='hidden';form.addEventListener('submit',event=>{event.preventDefault();if(input.value.trim()!=='101011'){window.location.href='https://youtu.be/lIsTm0lGzY4';return}error.textContent='';gate.remove();site.hidden=false;document.body.style.overflow='';});})();
const openBtn=document.getElementById('open-menu-btn'),closeBtn=document.getElementById('close-menu-btn'),menu=document.getElementById('mobile-menu'),themeToggle=document.getElementById('theme-toggle'),themePanel=document.getElementById('theme-panel'),sourcePage=document.getElementById('source-page'),sourceBtn=document.getElementById('source-btn'),sourceBack=document.getElementById('source-back'),sourceCode=document.getElementById('source-code'),copyButton=document.getElementById('copy-button'),copyStatus=document.getElementById('copy-status');
function openMenu(){menu.classList.add('open');document.body.style.overflow='hidden'}function closeMenu(){menu.classList.remove('open');document.body.style.overflow='';themePanel.style.display='none'}openBtn.addEventListener('click',openMenu);closeBtn.addEventListener('click',closeMenu);document.querySelectorAll(".menu-content a[href^='#']").forEach(link=>link.addEventListener('click',closeMenu));themeToggle.addEventListener('click',()=>{themePanel.style.display=themePanel.style.display==='none'?'grid':'none'});
const themes={birthday:{'--bg':'#fff8ed','--surface':'#ffffff','--surface2':'#fff0d8','--text':'#24172b','--muted':'#766879','--primary':'#ff6b8a','--primary2':'#ffc36b','--accent':'#7c6cff','--accent2':'#e8e4ff','--green':'#39c987','--border':'rgba(48,28,50,.12)','--shadow':'0 24px 70px rgba(210,106,91,.18)','--glass':'rgba(255,255,255,.66)'},blue:{'--bg':'#f3faff','--surface':'#ffffff','--surface2':'#eaf7ff','--text':'#111923','--muted':'#667582','--primary':'#65b9ff','--primary2':'#bde6ff','--accent':'#ff7eae','--accent2':'#ffe3ef','--green':'#39c987','--border':'rgba(20,45,65,.12)','--shadow':'0 24px 70px rgba(58,139,193,.16)','--glass':'rgba(255,255,255,.66)'},lavender:{'--bg':'#fbf8ff','--surface':'#ffffff','--surface2':'#f3ebff','--text':'#1b1720','--muted':'#756c80','--primary':'#b184ff','--primary2':'#dcc6ff','--accent':'#ffbd69','--accent2':'#fff0d7','--green':'#39c987','--border':'rgba(50,30,70,.12)','--shadow':'0 24px 70px rgba(120,80,190,.16)','--glass':'rgba(255,255,255,.66)'},night:{'--bg':'#111018','--surface':'#1b1924','--surface2':'#262332','--text':'#f7f4fb','--muted':'#aaa2b5','--primary':'#ff79b3','--primary2':'#6d3f5b','--accent':'#6d91ff','--accent2':'#293352','--green':'#48d99a','--border':'rgba(255,255,255,.12)','--shadow':'0 24px 70px rgba(0,0,0,.35)','--glass':'rgba(30,28,40,.66)'}};
function applyTheme(name){const theme=themes[name]||themes.birthday;Object.entries(theme).forEach(([key,value])=>document.documentElement.style.setProperty(key,value));document.querySelectorAll('.theme-btn').forEach(btn=>btn.classList.toggle('active',btn.dataset.theme===name));try{localStorage.setItem('birthday-theme',name)}catch(e){}}document.querySelectorAll('.theme-btn').forEach(btn=>btn.addEventListener('click',()=>applyTheme(btn.dataset.theme)));let savedTheme='birthday';try{savedTheme=localStorage.getItem('birthday-theme')||'birthday'}catch(e){}applyTheme(savedTheme);
const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target)}})},{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
function getSource(){return '<!DOCTYPE html>\n'+document.documentElement.outerHTML}sourceBtn.addEventListener('click',()=>{sourceCode.textContent=getSource();sourcePage.classList.add('open');menu.classList.remove('open');themePanel.style.display='none';document.body.style.overflow='hidden'});sourceBack.addEventListener('click',()=>{sourcePage.classList.remove('open');openMenu()});copyButton.addEventListener('click',async()=>{const code=sourceCode.textContent;let copied=false;try{if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(code);copied=true}else{const ta=document.createElement('textarea');ta.value=code;ta.setAttribute('readonly','');ta.style.position='fixed';ta.style.left='-9999px';ta.style.top='0';document.body.appendChild(ta);ta.select();ta.setSelectionRange(0,ta.value.length);copied=document.execCommand('copy');ta.remove()}}catch(e){copied=false}if(copied){copyButton.classList.add('copied');copyStatus.textContent='Code copied';copyStatus.classList.remove('failed');setTimeout(()=>{copyButton.classList.remove('copied');copyStatus.textContent=''},2200)}else{copyStatus.textContent='Failed to copy';copyStatus.classList.add('failed');setTimeout(()=>{copyStatus.textContent='';copyStatus.classList.remove('failed')},2600)}});
/* Version 1 confetti behavior: lighter particle count, varied shapes, spin and curved drift. */
(function(){const canvas=document.getElementById('celebration-canvas'),ctx=canvas.getContext('2d');if(!ctx)return;const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;let w=0,h=0,particles=[];const colors=['#ff6b8a','#ffc36b','#7c6cff','#61c9c3','#ff9e55','#e9a4ff'];function makeParticle(initial){return{x:Math.random()*w,y:initial?Math.random()*h:-15,size:2+Math.random()*5,speed:.35+Math.random()*1.2,drift:(Math.random()-.5)*.8,rotation:Math.random()*Math.PI*2,spin:(Math.random()-.5)*.035,color:colors[Math.floor(Math.random()*colors.length)],shape:Math.random()>.55?'rect':'circle',alpha:.35+Math.random()*.55}}function resize(){const dpr=Math.min(window.devicePixelRatio||1,2);w=window.innerWidth;h=window.innerHeight;canvas.width=w*dpr;canvas.height=h*dpr;canvas.style.width=w+'px';canvas.style.height=h+'px';ctx.setTransform(dpr,0,0,dpr,0,0);const count=Math.min(95,Math.max(35,Math.floor(w/14)));particles=Array.from({length:count},()=>makeParticle(true))}function draw(){ctx.clearRect(0,0,w,h);for(const p of particles){ctx.save();ctx.globalAlpha=p.alpha;ctx.fillStyle=p.color;ctx.translate(p.x,p.y);ctx.rotate(p.rotation);if(p.shape==='rect')ctx.fillRect(-p.size/2,-p.size/2,p.size,p.size*1.8);else{ctx.beginPath();ctx.arc(0,0,p.size/2,0,Math.PI*2);ctx.fill()}ctx.restore();if(!reduceMotion){p.y+=p.speed;p.x+=p.drift+Math.sin(p.y/55)*.25;p.rotation+=p.spin;if(p.y>h+20){Object.assign(p,makeParticle(false));p.x=Math.random()*w}}}if(!reduceMotion)requestAnimationFrame(draw)}window.addEventListener('resize',resize,{passive:true});resize();draw()})();
</script>
